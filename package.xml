<?xml version="1.0"?>
<package format="3">
  <name>gpd_ros</name>
  <version>0.0.1</version>
  <description>ROS 2 interface mirror of GPD (messages/services only, no nodes)</description>

  <maintainer email="you@example.com">Your Name</maintainer>
  <license>BSD-3-Clause</license>

  <!-- Build tools -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Runtime for generated type support -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Message deps: include every package referenced in your .msg/.srv fields -->
  <!-- Remove ones you don't actually use; add others as needed -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>pcl_msgs</depend>
  <depend>tf2_eigen</depend>

  <!-- Mark as an interface package so tools can discover it -->
  <member_of_group>rosidl_interface_packages</member_of_group>
</package>